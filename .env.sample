NODE_ENV=development
PORT=3000
CONFIG_PATH=config/config.json
DATA_DIR=data
LOG_LEVEL=info

# Default is true for safe testing. Set both here and config/config.json to false to automate actions.
DRY_RUN=true
HEADLESS=true

# Twitter/X credentials are optional if you log in manually using the persisted browser profile.
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=

# Discord notifications.
DISCORD_WEBHOOK_URL=

# OpenAI-compatible parser/reply generation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
